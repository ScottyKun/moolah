---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import MenuList from '../components/MenuList.astro';
import TableBooking from '../components/TableBooking.astro';
import { hotel, menu, hours } from '../data/hotel';
import { menuSchema, placeSchema } from '../data/schema';

const schema = placeSchema(Astro.site, 'Restaurant', 'Restaurant du Moolah Hotel', {
  servesCuisine: ['Camerounaise', 'Internationale'],
  hasMenu: menuSchema(menu, 'La carte du restaurant'),
});
---

<Base
  title="Restaurant"
  description="Le restaurant du Moolah Hotel à Batcham : cuisine camerounaise et internationale, ouvert à tous. Carte en ligne, réservation par WhatsApp ou téléphone."
  schema={schema}
>
  <section class="wrap intro">
    <div>
      <h1>Le restaurant</h1>
      <hr class="rule-or" />
      <p class="lede">Cuisine camerounaise et internationale, servie au restaurant ou dans votre chambre.</p>
      <p>Le restaurant est ouvert aux clients de l'hôtel comme aux visiteurs.</p>
      <TableBooking place="restaurant" hours={hours.restaurant} />
    </div>
    <Photo alt="Un plat de taro sauce jaune" ratio="4 / 3" eager />
  </section>

  <section class="section section-alt" aria-labelledby="carte-title">
    <div class="wrap">
      <div class="head">
        <h2 id="carte-title">La carte</h2>
        <a href="/bar-lounge">Voir la carte des boissons</a>
      </div>
      <hr class="rule-or" />
      <MenuList sections={menu} />
      <p class="caption">Carte susceptible d'évoluer selon le marché. Prix TTC, TVA de {hotel.vat} incluse.</p>
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 5fr 7fr; gap: 48px; align-items: center; padding-block: 64px var(--section); }
  .intro :global(.photo) { border-radius: var(--radius-card); }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .head a { font-weight: 600; }
  @media (max-width: 860px) { .intro { grid-template-columns: 1fr; gap: 24px; padding-top: 40px; } }
</style>